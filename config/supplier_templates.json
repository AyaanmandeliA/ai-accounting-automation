    {
      "id": "example_telecom_bill",
      "enabled": true,
      "supplier_name": "Example Telecom",
      "supplier_name_patterns": [
        "\\bexample telecom\\b",
        "\\bexample telecommunications\\b"
      ],
      "invoice_number_regex": "(?:Invoice\\s*(?:No\\.?|Number)|Bill\\s*(?:No\\.?|Number))\\s*[:#-]?\\s*([A-Z0-9][A-Z0-9\\-/]{3,})",
      "date_regex": "(?:Invoice\\s*Date|Bill\\s*Date|Date)\\s*[:#-]?\\s*(\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}|\\d{4}[/-]\\d{1,2}[/-]\\d{1,2})",
      "subtotal_regex": "(?:Subtotal|Sub\\s*Total|Amount\\s*Before\\s*VAT)\\s*[:#-]?\\s*(?:AED|د\\.إ)?\\s*([0-9,]+(?:\\.\\d{2})?)",
      "vat_regex": "(?:VAT|Tax\\s*Amount)\\s*[:#-]?\\s*(?:AED|د\\.إ)?\\s*([0-9,]+(?:\\.\\d{2})?)",
      "total_regex": "^\\s*(?:Total\\s*Amount|Grand\\s*Total|Amount\\s*Due|Total)\\s*[:#-]?\\s*(?:AED|د\\.إ)?\\s*([0-9,]+(?:\\.\\d{2})?)",
      "trn_regex": "(?:TRN|Tax\\s*Registration\\s*Number)\\s*[:#-]?\\s*(\\d{15})",
      "default_account": "Telephone & Internet",
      "default_posting_type": "Bill",
      "default_vat_treatment": "Claimable VAT",
      "default_accounting_treatment": "supplier_bill_unpaid",
      "default_payment_method": "unpaid",
      "currency": "AED",
      "confidence_rules": {
        "minimum_confidence": 0.9,
        "required_fields": [
          "supplier_name",
          "invoice_number",
          "invoice_date",
          "total_amount"
        ],
        "field_weights": {
          "supplier_name": 0.2,
          "invoice_number": 0.2,
          "invoice_date": 0.2,
          "total_amount": 0.2,
          "tax_amount": 0.1,
          "supplier_trn": 0.1
        }
      }
    },
